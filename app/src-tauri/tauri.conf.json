{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Среда",
  "version": "0.2.3",
  "identifier": "local.sreda.kanban",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Среда · Локальные доски",
        "width": 1440,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 760,
        "backgroundColor": "#161719",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss: http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "publisher": "Среда",
    "shortDescription": "Локальные канбан-доски",
    "longDescription": "Среда — локальные канбан-доски с совместной работой по ссылке.",
    "category": "Productivity",
    "copyright": "© 2026 Среда",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Среда"
      }
    }
  }
}
