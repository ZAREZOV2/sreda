{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sreda.local/schemas/sreda-theme.schema.json",
  "title": "Тема «Среды» (*.sreda-theme.json)",
  "type": "object",
  "required": [
    "name",
    "version",
    "base",
    "tokens"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Название темы, показывается в настройках."
    },
    "author": {
      "type": "string",
      "maxLength": 80,
      "description": "Автор темы."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Версия темы (semver)."
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "base": {
      "enum": [
        "dark",
        "light"
      ],
      "description": "Базовая тема: все незаданные токены берутся из неё."
    },
    "tokens": {
      "type": "object",
      "description": "Переопределения токенов. Ключ — имя CSS-переменной без «--».",
      "propertyNames": {
        "enum": [
          "bg",
          "bg-sidebar",
          "surface",
          "surface-raised",
          "surface-hover",
          "surface-overlay",
          "surface-sunken",
          "border",
          "border-strong",
          "border-input",
          "text",
          "text-secondary",
          "muted",
          "text-disabled",
          "accent",
          "accent-text",
          "primary",
          "primary-hover",
          "primary-active",
          "on-primary",
          "accent-soft",
          "accent-soft-border",
          "accent-soft-text",
          "focus-ring",
          "selection",
          "danger",
          "danger-hover",
          "on-danger",
          "danger-soft",
          "danger-text",
          "warning",
          "warning-soft",
          "warning-text",
          "success",
          "success-soft",
          "success-text",
          "info",
          "info-soft",
          "info-text",
          "label-sage-bg",
          "label-sage-fg",
          "label-blue-bg",
          "label-blue-fg",
          "label-amber-bg",
          "label-amber-fg",
          "label-rose-bg",
          "label-rose-fg",
          "label-violet-bg",
          "label-violet-fg",
          "label-gray-bg",
          "label-gray-fg",
          "priority-high-bg",
          "priority-high-fg",
          "priority-high-border",
          "priority-normal-bg",
          "priority-normal-fg",
          "priority-normal-border",
          "priority-low-bg",
          "priority-low-fg",
          "priority-low-border",
          "col-todo",
          "col-progress",
          "col-done",
          "col-progress-card-bg",
          "col-progress-card-border",
          "online",
          "away",
          "offline",
          "presence-ring",
          "avatar-bg",
          "avatar-fg",
          "avatar-border",
          "scrim",
          "shadow-sm",
          "shadow-card",
          "shadow-md",
          "shadow-lg",
          "shadow-drawer",
          "radius-xs",
          "radius-sm",
          "radius-md",
          "radius-card",
          "radius-lg",
          "radius-xl",
          "radius-full",
          "font-sans",
          "font-mono",
          "font-size-base",
          "fs-xs",
          "fs-sm",
          "fs-md",
          "fs-base",
          "fs-lg",
          "fs-xl",
          "fs-2xl",
          "fs-3xl",
          "fs-display",
          "fw-regular",
          "fw-medium",
          "fw-semibold",
          "fw-bold",
          "lh-tight",
          "lh-base",
          "density",
          "control-h-sm",
          "control-h-md",
          "control-h-lg",
          "card-pad",
          "column-gap",
          "space-1",
          "space-2",
          "space-3",
          "space-4",
          "space-5",
          "space-6",
          "space-8",
          "space-10",
          "space-12",
          "space-16",
          "z-dropdown",
          "z-sticky",
          "z-drawer",
          "z-modal",
          "z-toast",
          "z-tooltip",
          "dur-fast",
          "dur-base",
          "dur-slow",
          "dur-slower",
          "ease-standard",
          "ease-out"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^[^;{}<>\\\\]*$",
        "not": {
          "pattern": "(?i)(url\\s*\\(|expression\\s*\\(|javascript:|@import)"
        }
      }
    },
    "css": {
      "type": "string",
      "maxLength": 20000,
      "description": "Необязательные тонкие правки CSS. Проходит санитайзер приложения: без @import, внешних url() и сетевых шрифтов.",
      "not": {
        "pattern": "(?i)(@import|url\\s*\\(\\s*['\"]?\\s*(https?:|//|ftp:)|javascript:|expression\\s*\\(|<\\/?style|<script)"
      }
    }
  }
}