{
  "name": "sreda-kanban",
  "version": "0.3.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ZAREZOV2/sreda.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/ZAREZOV2/sreda/issues"
  },
  "homepage": "https://github.com/ZAREZOV2/sreda#readme",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../scripts/build-frontend.mjs",
    "desktop": "tauri build --no-bundle",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --no-default-features --features desktop",
    "installer": "tauri build --bundles nsis",
    "release": "node ../scripts/release.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/extension-code-block-lowlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-table-cell": "^3.33.1",
    "@tiptap/extension-table-header": "^3.33.1",
    "@tiptap/extension-table-row": "^3.33.1",
    "@tiptap/extension-task-item": "^3.33.1",
    "@tiptap/extension-task-list": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.0",
    "typescript": "~7.0.2",
    "vite": "^6.1.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
