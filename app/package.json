{
  "name": "sreda-kanban",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../scripts/build-frontend.mjs",
    "desktop": "tauri build --no-bundle",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --no-default-features --features desktop",
    "installer": "tauri build --bundles nsis",
    "release": "node ../scripts/release.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.10.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
